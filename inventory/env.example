# ==============================================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO: VARIABLES MAESTRAS DE DESPLIEGUE
# Copie este archivo a 'config/env' y ajuste los valores a su entorno real:
#   cp config/env.example config/env
#   chmod 600 config/env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PARÁMETROS GENERALES DEL DOMINIO Y USUARIOS
# ------------------------------------------------------------------------------
DOMAIN="lab.local"                               # [POR DEFINIR] FQDN del laboratorio o empresa
ADMIN_USER="debian"                              # Usuario administrador con privilegios sudo
TIMEZONE="UTC"                                   # Zona horaria estándar UTC

# ------------------------------------------------------------------------------
# 2. TOPOLOGÍA DE RED Y ENRUTAMIENTO (SUBNET L2 AISLADA DEL CLÚSTER)
# ------------------------------------------------------------------------------
INTERNAL_SUBNET="10.100.29.0/24"
INTERNAL_NETMASK="255.255.255.0"
INTERNAL_GATEWAY="10.100.29.10"                     # IP LAN del Bastion Host (Gateway del clúster)
INTERNAL_DNS="192.168.26.120"                       # Servidor DNS Corporativo
DHCP_RANGE_START="10.100.29.50"
DHCP_RANGE_END="10.100.29.99"
DHCP_LEASE_TIME="1h"

# ------------------------------------------------------------------------------
# 3. NODO 314: BASTION HOST, ENRUTAMIENTO Y SEGURIDAD PERIMETRAL
# ------------------------------------------------------------------------------
BASTION_HOSTNAME="bastion"
BASTION_LAN_IP="10.100.29.10"
BASTION_LAN_IFACE="enp3s0"                         # Interfaz conectada a la red privada 10.100.29.0/24
BASTION_WAN_IP="10.101.29.10"                      # IP en la red corporativa/oficina
BASTION_WAN_IFACE="enp2s0"                         # Interfaz conectada a la red corporativa (WAN)
BASTION_WAN_GATEWAY="10.101.29.1"                  # Puerta de enlace de la oficina
BASTION_WAN_DNS="192.168.26.120"                   # Servidor DNS corporativo
ADMIN_ALLOWED_IPS="10.101.29.0/24"                 # Subred o IP de la laptop de administración
BASTION_SSH_PORT="22"                              # Puerto SSH
SQUID_PORT="3128"                                  # Puerto proxy HTTP/HTTPS Egress
CHRONY_NTP_PORT="123"

# ------------------------------------------------------------------------------
# 4. NODO 315: SONATYPE NEXUS 3 Y POSTGRESQL 16
# ------------------------------------------------------------------------------
NEXUS_HOSTNAME="nexus-repo"
NEXUS_IP="10.100.29.20"
NEXUS_PORT="8081"                                # UI Web y Proxy APT
NEXUS_DOCKER_GROUP_PORT="8082"                   # Registro Docker Group (Lectura/Pull)
NEXUS_DOCKER_HOSTED_PORT="8083"                  # Registro Docker Hosted (Escritura/Push)
POSTGRES_PORT="5432"
POSTGRES_NEXUS_DB="nexus"
POSTGRES_NEXUS_USER="nexus"
POSTGRES_NEXUS_PASSWORD="<POSTGRES_NEXUS_PASSWORD>" # [SECRETO] Mínimo 16 caracteres
NEXUS_JVM_HEAP_MB="4096"                         # 4 GB para nodos de 16 GB RAM
NEXUS_BLOBSTORE_QUOTA_GB="60"                    # Límite máximo para disco de 128 GB

# ------------------------------------------------------------------------------
# 5. NODO 306: PXE CONTROLLER, GLANCE HTTP E IRONIC STANDALONE
# ------------------------------------------------------------------------------
PXE_HOSTNAME="pxe-controller"
PXE_IP="10.100.29.30"
PXE_IFACE="eth0"                                 # Interfaz conectada al switch privado
TFTP_PORT="69"
HTTPBOOT_PORT="8089"                             # Servidor Nginx para kernel e imágenes
IRONIC_API_PORT="6385"                           # API REST de OpenStack Ironic Standalone
IRONIC_IMAGE_NAME="debian-baremetal.qcow2"
IRONIC_IMAGE_CHECKSUM="c3ab8ff13720e8ad9047dd39466b3c8974e592c2fa383d4a3960714caef0c4f2"

# ------------------------------------------------------------------------------
# 6. CLÚSTER KUBERNETES (RKE2 + CILIUM eBPF)
# ------------------------------------------------------------------------------
RKE2_VERSION="v1.30.2+rke2r1"                    # Versión estable compatible con Debian 13
RKE2_CLUSTER_TOKEN="<RKE2_CLUSTER_TOKEN>"        # [SECRETO] Token compartido de autenticación RKE2
RKE2_CNI="cilium"                                # CNI acelerado eBPF sin kube-proxy
ETCD_QUOTA_BACKEND_BYTES="4294967296"            # 4 GB de cuota máxima de etcd
ETCD_COMPACTION_RETENTION="1"                    # Compactar cada 1 hora

# ------------------------------------------------------------------------------
# 7. CONTROL DE ENERGÍA DE HARDWARE (POWER MANAGEMENT)
# ------------------------------------------------------------------------------
POWER_METHOD="wol"                               # Métodos: wol, ipmi, redfish, manual
BMC_USER="admin"                                 # Usuario de gestión IPMI / Redfish
BMC_PASSWORD="<BMC_PASSWORD>"                    # Contraseña de gestión IPMI / Redfish

# ------------------------------------------------------------------------------
# 8. RUTAS DE LLAVES SSH CRIPTOGRÁFICAS
# ------------------------------------------------------------------------------
SSH_KEY_BASTION="$HOME/.ssh/id_ed25519_bastion"
SSH_KEY_NODES="$HOME/.ssh/id_ed25519_nodes"
