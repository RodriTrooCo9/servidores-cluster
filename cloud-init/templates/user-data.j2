#cloud-config
manage_etc_hosts: true
package_update: true
users:
  - default
  - name: {{ admin_user | default('debian') }}
    gecos: Debian Admin
    sudo: ALL=(ALL) NOPASSWD:ALL
    groups: sudo, adm
    shell: /bin/bash
    lock_passwd: false
    ssh_authorized_keys:
      - "{{ ssh_public_key }}"

packages:
  - curl
  - iptables
  - apparmor
  - socat
  - conntrack
  - openssh-server

apt:
  sources:
    nexus:
      source: "deb http://{{ nexus_ip | default('10.100.29.20') }}:8081/repository/debian-proxy/ trixie main contrib non-free non-free-firmware"

write_files:
  - path: /etc/modules-load.d/k8s.conf
    content: |
      overlay
      br_netfilter
  - path: /etc/sysctl.d/99-kubernetes.conf
    content: |
      net.bridge.bridge-nf-call-iptables = 1
      net.bridge.bridge-nf-call-ip6tables = 1
      net.ipv4.ip_forward = 1

runcmd:
  - swapoff -a
  - sed -i '/ swap / s/^\(.*\)$/# \1/g' /etc/fstab
  - modprobe overlay
  - modprobe br_netfilter
  - sysctl --system
  - systemctl restart ssh
