---
# Yamllint configuration for Ansible, OpenStack and Kubernetes
extends: default

rules:
  line-length:
    max: 300
    level: warning
  truthy:
    check-keys: false
    level: warning
  comments:
    min-spaces-from-content: 1
    level: warning
  comments-indentation: false
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  empty-lines:
    max: 3
    level: warning
  trailing-spaces:
    level: warning
  new-line-at-end-of-file:
    level: warning
  document-start: disable
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1

ignore: |
  .venv*/
  .git/
  artifacts/
  backups/
  reports/
