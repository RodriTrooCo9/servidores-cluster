---
# Yamllint configuration for Ansible and Kubernetes
extends: default

rules:
  line-length:
    max: 200
    level: warning
  truthy:
    check-keys: false
    level: warning
  comments:
    min-spaces-from-content: 1
    level: warning
  document-start: disable
  brackets:
    min-spaces-inside: 0
    max-spaces-inside: 1
  braces:
    min-spaces-inside: 0
    max-spaces-inside: 1
  empty-lines:
    max: 2

ignore: |
  .venv*/
  .git/
  artifacts/
  backups/
