{
  "uid": "lab-extra-metricas",
  "title": "02 · Métricas de nodos y Kubernetes",
  "schemaVersion": 40,
  "editable": false,
  "tags": [
    "laboratorio",
    "observabilidad-extra"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "title": "CPU por nodo",
      "type": "grafana-polystat-panel",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "options": {
        "globalOperator": "lastNotNull",
        "globalShape": "hexagon_pointed_top",
        "globalDisplayMode": "all",
        "layoutDisplayLimit": 0,
        "globalUnitFormat": "percent",
        "globalDecimals": 0,
        "globalShowValueEnabled": true,
        "globalThresholdsConfig": [
          {
            "value": 0,
            "state": 0,
            "color": "#299c46"
          },
          {
            "value": 75,
            "state": 1,
            "color": "#e0b400"
          },
          {
            "value": 90,
            "state": 2,
            "color": "#e02f44"
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-BareMetal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus-BareMetal"
          },
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"baremetal-nodes\",mode=\"idle\"}[5m])))",
          "instant": true,
          "range": false,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "pluginVersion": "2.1.16",
      "id": 1
    },
    {
      "title": "Memoria por nodo",
      "type": "grafana-polystat-panel",
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "options": {
        "globalOperator": "lastNotNull",
        "globalShape": "hexagon_pointed_top",
        "globalDisplayMode": "all",
        "layoutDisplayLimit": 0,
        "globalUnitFormat": "percent",
        "globalDecimals": 0,
        "globalShowValueEnabled": true,
        "globalThresholdsConfig": [
          {
            "value": 0,
            "state": 0,
            "color": "#299c46"
          },
          {
            "value": 75,
            "state": 1,
            "color": "#e0b400"
          },
          {
            "value": 90,
            "state": 2,
            "color": "#e02f44"
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-BareMetal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus-BareMetal"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes{job=\"baremetal-nodes\"} / node_memory_MemTotal_bytes{job=\"baremetal-nodes\"})",
          "instant": true,
          "range": false,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "pluginVersion": "2.1.16",
      "id": 2
    },
    {
      "title": "Disco raíz por nodo",
      "type": "grafana-polystat-panel",
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 9
      },
      "options": {
        "globalOperator": "lastNotNull",
        "globalShape": "hexagon_pointed_top",
        "globalDisplayMode": "all",
        "layoutDisplayLimit": 0,
        "globalUnitFormat": "percent",
        "globalDecimals": 0,
        "globalShowValueEnabled": true,
        "globalThresholdsConfig": [
          {
            "value": 0,
            "state": 0,
            "color": "#299c46"
          },
          {
            "value": 75,
            "state": 1,
            "color": "#e0b400"
          },
          {
            "value": 90,
            "state": 2,
            "color": "#e02f44"
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-BareMetal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus-BareMetal"
          },
          "expr": "100 * (1 - node_filesystem_avail_bytes{job=\"baremetal-nodes\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"baremetal-nodes\",mountpoint=\"/\"})",
          "instant": true,
          "range": false,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "pluginVersion": "2.1.16",
      "id": 3
    },
    {
      "title": "CPU por namespace",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-BareMetal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus-BareMetal"
          },
          "expr": "sum by (namespace) (rate(container_cpu_usage_seconds_total{job=\"kubernetes-cadvisor\",namespace!=\"\",container!=\"\",container!=\"POD\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "id": 4
    },
    {
      "title": "Memoria por namespace",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-BareMetal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus-BareMetal"
          },
          "expr": "sum by (namespace) (container_memory_working_set_bytes{job=\"kubernetes-cadvisor\",namespace!=\"\",container!=\"\",container!=\"POD\"})",
          "instant": false,
          "range": true,
          "legendFormat": "{{namespace}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "title": "CPU de los pods de aplicaciones",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-BareMetal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus-BareMetal"
          },
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{job=\"kubernetes-cadvisor\",namespace=\"aplicaciones\",container!=\"\",container!=\"POD\"}[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "id": 6
    },
    {
      "title": "Memoria de los pods de aplicaciones",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 8
      },
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-BareMetal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus-BareMetal"
          },
          "expr": "sum by (pod) (container_memory_working_set_bytes{job=\"kubernetes-cadvisor\",namespace=\"aplicaciones\",container!=\"\",container!=\"POD\"})",
          "instant": false,
          "range": true,
          "legendFormat": "{{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "title": "Solicitudes a la API Kubernetes por código",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-BareMetal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus-BareMetal"
          },
          "expr": "sum by (code) (rate(apiserver_request_total[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "id": 8
    },
    {
      "title": "Tráfico de las interfaces del gateway",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 8
      },
      "options": {},
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-BareMetal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus-BareMetal"
          },
          "expr": "label_replace(rate(node_network_receive_bytes_total{instance=\"pxe-controller\",device=~\"enp2s0|wlp3s0\"}[5m]), \"direction\", \"Entrada\", \"device\", \".*\") or label_replace(rate(node_network_transmit_bytes_total{instance=\"pxe-controller\",device=~\"enp2s0|wlp3s0\"}[5m]), \"direction\", \"Salida\", \"device\", \".*\")",
          "instant": false,
          "range": true,
          "legendFormat": "{{device}} · {{direction}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "id": 9
    }
  ],
