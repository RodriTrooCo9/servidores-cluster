{
  "uid": "lab-extra-logs",
  "title": "03 · Logs de aplicaciones",
  "schemaVersion": 40,
  "editable": false,
  "tags": [
    "laboratorio",
    "observabilidad-extra"
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Volumen de logs en Loki por contenedor",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "options": {},
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "sum by (service_name) (count_over_time({k8s_namespace_name=\"aplicaciones\"}[5m]))",
          "queryType": "range",
          "legendFormat": "{{service_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 1
    },
    {
      "title": "Loki · registros recientes",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 16
      },
      "options": {
        "showLabels": true,
        "showTime": true,
        "enableLogDetails": true,
        "wrapLogMessage": true
      },
      "datasource": {
        "type": "loki",
        "uid": "Loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "Loki"
          },
          "expr": "{k8s_namespace_name=\"aplicaciones\"}",
          "queryType": "range",
          "maxLines": 150
        }
      ],
      "id": 2
    },
    {
      "title": "VictoriaLogs · registros recientes",
      "type": "logs",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 16
      },
      "options": {
        "showLabels": true,
        "showTime": true,
        "enableLogDetails": true,
        "wrapLogMessage": true
      },
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "victoria-logs"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "victoria-logs"
          },
          "expr": "k8s.namespace.name:=\"aplicaciones\"",
          "queryType": "instant",
          "maxLines": 150
        }
      ],
      "id": 3
    }
  ],
