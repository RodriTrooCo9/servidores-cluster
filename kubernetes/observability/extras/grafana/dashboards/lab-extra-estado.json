  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "title": "Node Exporter · uno por nodo",
      "type": "grafana-polystat-panel",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "options": {
        "globalOperator": "lastNotNull",
        "globalShape": "hexagon_pointed_top",
        "globalDisplayMode": "all",
        "layoutDisplayLimit": 0,
        "globalUnitFormat": "short",
        "globalDecimals": 0,
        "globalShowValueEnabled": true,
        "globalThresholdsConfig": [
          {
            "value": 0,
            "state": 2,
            "color": "#e02f44"
          },
          {
            "value": 1,
            "state": 0,
            "color": "#299c46"
          }
        ]
      },
      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus-BareMetal"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus-BareMetal"
          },
          "expr": "up{job=\"baremetal-nodes\"}",
          "instant": true,
          "range": false,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "pluginVersion": "2.1.16",
      "id": 1
    },
    {
      "title": "Kubelet y API de Kubernetes",
      "type": "grafana-polystat-panel",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "options": {
        "globalOperator": "lastNotNull",
        "globalShape": "hexagon_pointed_top",
        "globalDisplayMode": "all",
        "layoutDisplayLimit": 0,
        "globalUnitFormat": "short",
        "globalDecimals": 0,
        "globalShowValueEnabled": true,
