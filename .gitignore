# Archivos de entorno con credenciales reales
config/env
/ansible.cfg
/inventory

# Respaldo automático de configuraciones
*.bak.*
*.backup

# Llaves criptográficas y secretos
*.id_ed25519*
*.id_rsa*
*.pem
*.key
*.crt
*.pfx
vault_*.yml
admin.password
.vault_pass*
ansible/.vault_pass*
ansible/keys/*
!ansible/keys/.gitkeep
!ansible/keys/README.md

# Configuración de clúster y certificados
rke2.yaml
kubeconfig
*.kubeconfig
*openrc*
clouds.yaml

# Archivos de logs de ejecución
/var/log/infra-setup/
*.log

