        <mxCell id="observability-status" value="&lt;span style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Diagnóstico y carga&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;k6 y JMeter tienen definiciones versionadas.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;El adjunto refiere ejecuciones distribuidas con k6.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Pendiente: conservar informes reproducibles y correlacionar&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;carga, latencia y fallos con las señales de la aplicación.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fontFamily=Inter,Helvetica;fontColor=#73511E;fontSize=16;fillColor=#FFF7E7;strokeColor=#D8B774;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry x="482" y="352" width="426" height="126" as="geometry" />
        </mxCell>
        <mxCell id="backup-status" value="&lt;span style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Respaldos del laboratorio&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;etcd y Nexus: copias con checksum, restauración pendiente.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;VictoriaMetrics: vmrestore en directorio aislado.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Pendiente: copia externa y consulta de datos restaurados.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Kolla/Glance: copia de archivos; falta respaldo de MariaDB.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fontFamily=Inter,Helvetica;fontColor=#154B73;fontSize=16;fillColor=#EEF6FC;strokeColor=#83B3D6;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry x="32" y="504" width="426" height="126" as="geometry" />
