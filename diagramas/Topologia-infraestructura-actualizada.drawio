        <mxCell id="platform-status" value="&lt;span style=&quot;font-size:17px&quot;&gt;&lt;b&gt;RKE2 y aplicaciones&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Registrado: siete nodos Ready el 30/10/2026.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;El registro de observabilidad extra recoge pruebas de la app,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;logs en Loki/VictoriaLogs y trazas en Tempo.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Pendiente: reconciliar roles del inventario y validar alta nueva.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fontFamily=Inter,Helvetica;fontColor=#154B73;fontSize=16;fillColor=#EEF6FC;strokeColor=#83B3D6;strokeWidth=1.4;" vertex="1" parent="1">
          <mxGeometry x="32" y="352" width="426" height="126" as="geometry" />
