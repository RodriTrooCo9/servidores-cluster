        <mxCell id="provision-status" value="&lt;span style=&quot;font-size:17px&quot;&gt;&lt;b&gt;Aprovisionamiento y trazabilidad&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Pendiente: probar Ironic/iPXE en un equipo de principio a fin,&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;completar el build Packer y validar el primer arranque.&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;Ampliar el caso de trazas hasta una consulta real a base&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;de datos y registrar un fallo controlado bajo carga.&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=6;spacingLeft=10;spacingRight=10;fontFamily=Inter,Helvetica;fontColor=#73511E;fontSize=16;fillColor=#FFF7E7;strokeColor=#D8B774;strokeWidth=1.4;" vertex="1" parent="1">
