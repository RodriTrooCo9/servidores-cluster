---
# ==============================================================================
# OpenStack Kolla-Ansible Passwords Template (passwords.yml.example)
#
# Generar claves reales con:
#   kolla-genpwd -p openstack/secrets/passwords.yml
#
# Cifrar con Ansible Vault:
#   ansible-vault encrypt openstack/secrets/passwords.yml
# ==============================================================================

database_password: "CHANGEME_DATABASE_PASSWORD"
database_root_password: "CHANGEME_DATABASE_ROOT_PASSWORD"
keystone_admin_password: "CHANGEME_KEYSTONE_ADMIN_PASSWORD"
ironic_database_password: "CHANGEME_IRONIC_DB_PASSWORD"
ironic_keystone_password: "CHANGEME_IRONIC_KEYSTONE_PASSWORD"
glance_database_password: "CHANGEME_GLANCE_DB_PASSWORD"
glance_keystone_password: "CHANGEME_GLANCE_KEYSTONE_PASSWORD"
rabbitmq_password: "CHANGEME_RABBITMQ_PASSWORD"
horizon_secret_key: "CHANGEME_HORIZON_SECRET_KEY"
